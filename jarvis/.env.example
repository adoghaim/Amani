# =============================================================================
# Jarvis (Amani admin/growth agent) configuration
# Copy to jarvis/.env (setup.sh does this) and fill in. NEVER commit jarvis/.env.
# Format: KEY=value, one per line, sourced by bash. Quote values containing spaces.
# Tags:  [DAY-1] needed for the first read-only report
#        [REC]   recommended early (read-only, adds a report section)
#        [LATER] needed only for publishing / ads / channels not created yet
# Principle: every credential here should be the LEAST-PRIVILEGED, READ-ONLY variant.
# Write-capable credentials (publishing tokens) are only added when you approve that capability.
# =============================================================================

# ---- Core -------------------------------------------------------------------
# [DAY-1] Local time the report runs (24h HH:MM, machine-local time).
REPORT_TIME=07:30
# Label used in the report header (the schedule itself uses the machine's local clock).
REPORT_TIMEZONE=America/New_York
# [DAY-1] Must stay true. execute-approved.sh refuses to run otherwise; the daily run never writes.
OWNER_APPROVAL_REQUIRED=true
# Path to the Amani repo checkout. Default: the parent of this jarvis/ folder.
JARVIS_REPO_DIR=
# Fast-forward the checkout before each run (never commits/pushes). true|false
JARVIS_GIT_PULL=true
# Optional Claude model alias for the run (e.g. sonnet, opus). Empty = your subscription default.
JARVIS_MODEL=
JARVIS_MAX_TURNS=60
# Let Jarvis use WebSearch for trend/competitor context (read-only). true|false
JARVIS_ALLOW_WEB_SEARCH=false
# Optional: comma list to run only some collectors, e.g. github,factory,posthog
JARVIS_COLLECTORS=
JARVIS_COLLECTOR_TIMEOUT_MS=120000

# ---- Claude Code (runs on the owner's Claude SUBSCRIPTION, not an API key) ----
# Preferred: run `claude auth login` once on this machine (stored in macOS Keychain / ~/.claude).
# Headless/server alternative: `claude setup-token` (subscription-based long-lived token) and paste it here.
# Do NOT set ANTHROPIC_API_KEY; run-daily.sh unsets it so the subscription is always used.
CLAUDE_CODE_OAUTH_TOKEN=

# ---- Second Brain (optional, read-only) -----------------------------------------
# Local clone of the private adoghaim/Second-Brain vault. Jarvis reads '80 Skills/Load Project Context.md'
# and NEVER writes to it. Never put secrets in the vault.
# Default: $HOME/Desktop/Second-Brain (clone it with: git clone https://github.com/adoghaim/Second-Brain.git ~/Desktop/Second-Brain).
# Leave blank to use the default; Jarvis skips the vault if the folder doesn't exist.
SECOND_BRAIN_PATH=

# ---- GitHub (repo activity) ---------------------------------------------------
# [DAY-1] Repo to report on.
GITHUB_REPO=adoghaim/Amani
# Auth: preferably `gh auth login` on this machine. Or a fine-grained PAT with READ-ONLY
# Contents, Pull requests, Actions, Metadata on this repo only.
GH_TOKEN=
# [REC] Optional fine-grained read-only PAT for the GitHub MCP server (read-only endpoint).
# Separate name on purpose: Claude Code does not expand some well-known credential variable names into MCP headers.
GITHUB_MCP_PAT=

# ---- Factory status ledger ----------------------------------------------------
# Default: <repo>/factory/status.json, then <repo>/factory/STATUS.md. Override if elsewhere.
FACTORY_STATUS_PATH=

# ---- PostHog (product analytics, experiments, feature flags) -------------------
# [DAY-1] Private API host: https://us.posthog.com (US cloud) or https://eu.posthog.com (EU cloud).
POSTHOG_HOST=https://us.posthog.com
# [DAY-1] Project ID (Project settings).
POSTHOG_PROJECT_ID=
# [DAY-1] Personal API key (phx_...). Create with the "MCP Server" preset or with READ scopes only
# (query:read, experiment:read, feature_flag:read, insight:read ...), scoped to the Amani project.
POSTHOG_PERSONAL_API_KEY=
# Event names used for the funnel. Must match the app's instrumentation (open question for the owner).
POSTHOG_SIGNUP_EVENT=user_signed_up
POSTHOG_ACTIVATION_EVENT=lab_report_uploaded
POSTHOG_PREMIUM_EVENT=subscription_started

# ---- Supabase (aggregate product metrics) --------------------------------------
# Project ref (the only correct project per CLAUDE.md).
SUPABASE_PROJECT_REF=eyfvqdnczorscwveaadv
# [REC] Postgres connection string for the jarvis_readonly role created by sql/supabase-readonly-role.sql.
# That role can only read count-only views; it cannot see lab data, emails or files.
SUPABASE_READONLY_DB_URL=
# WARNING: never put SUPABASE_SERVICE_ROLE_KEY here. setup.sh fails if it is present.
# Optional, OFF by default: Supabase MCP (read_only=true). Needs a personal access token that is
# ACCOUNT-WIDE and can read row-level health data through SQL. Only enable if you accept that.
JARVIS_ENABLE_SUPABASE_MCP=false
SUPABASE_ACCESS_TOKEN=

# ---- Stripe (web subscriptions) ------------------------------------------------
# [REC] Restricted key (rk_live_...) with READ on Subscriptions, Customers, Invoices, Events; nothing else.
# A full secret key (sk_...) is refused.
STRIPE_RESTRICTED_KEY=

# ---- RevenueCat (iOS/Android subscriptions) -------------------------------------
# [REC] REST API v2 secret key (sk_...), created with read-only permissions where offered.
REVENUECAT_API_V2_KEY=
# [REC] Project ID (proj...).
REVENUECAT_PROJECT_ID=

# ---- App Store Connect API (iOS) ----------------------------------------------
# [REC] From App Store Connect > Users and Access > Integrations > App Store Connect API.
ASC_ISSUER_ID=
ASC_KEY_ID=
# Absolute path to the downloaded AuthKey_XXXX.p8 (keep it outside the repo, chmod 600).
ASC_PRIVATE_KEY_PATH=
# Numeric Apple ID of the Amani app (App Store Connect > App Information).
ASC_APP_ID=

# ---- Google Play Developer API (Android) --------------------------------------
# [REC] Absolute path to a service-account JSON invited in Play Console with view-only permissions.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Android package name (applicationId) of Amani.
GOOGLE_PLAY_PACKAGE_NAME=

# ---- Netlify (web hosting) ----------------------------------------------------
# [REC] Personal access token. Netlify PATs are not read-only scoped: create a dedicated one,
# set an expiry, and store it only here.
NETLIFY_AUTH_TOKEN=
# Site ID (API ID) of the amani-biometrics site.
NETLIFY_SITE_ID=

# ---- Meta: Facebook Page + Instagram professional account + Meta Ads ----------
# [LATER] Accounts not created yet; see SETUP_ACCOUNTS.md.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_PAGE_ID=
# Long-lived Page access token (read: pages_read_engagement, instagram_basic, instagram_manage_insights).
# Publishing (instagram_content_publish / pages_manage_posts) is a LATER, approval-gated capability.
META_PAGE_ACCESS_TOKEN=
META_IG_BUSINESS_ACCOUNT_ID=
# Ad account ID (act_123...) and a token with ads_read (system-user token recommended).
META_AD_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=

# ---- TikTok -------------------------------------------------------------------
# [LATER] TikTok for Developers app (Login Kit + Display API for stats; Content Posting API later).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# User access token for the Amani TikTok account (scopes: user.info.basic, user.info.stats, video.list).
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
# [LATER] TikTok API for Business (Ads reporting).
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_SECRET=
TIKTOK_BUSINESS_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_BUSINESS_API_VERSION=v1.3

# ---- YouTube ------------------------------------------------------------------
# [LATER] API key (restricted to YouTube Data API v3) for public channel stats.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# [LATER] OAuth client (Desktop app type) + refresh token, only needed for uploads/YouTube Analytics.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# ---- Pinterest ----------------------------------------------------------------
# [LATER] Pinterest app (API v5) + access token for the Amani business account (scopes: user_accounts:read, pins:read).
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=

# ---- X (Twitter) --------------------------------------------------------------
# [LATER] X API is pay-per-use; reads cost credits. Collector is off unless enabled.
X_ENABLE_COLLECTOR=false
X_USERNAME=
X_BEARER_TOKEN=
# User-context credentials, only for approved posting later.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ---- LinkedIn (company page) ----------------------------------------------------
# [LATER] Needs a LinkedIn Page + developer app verified by the page + Community Management API access.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
# Versioned API header, YYYYMM (check the currently supported versions).
LINKEDIN_API_VERSION=

# ---- Reddit (optional) ----------------------------------------------------------
# [LATER/OPTIONAL] Data API access now requires Reddit's approval (Responsible Builder Policy).
# Commercial use needs written approval. No collector ships for Reddit yet.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT="macos:amani-jarvis:v0.1 (by /u/YOUR_REDDIT_USERNAME)"

# ---- Google Ads API -------------------------------------------------------------
# [LATER] Developer token (from the Google Ads manager account API Center) + OAuth client + refresh token.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Account to report on (digits, dashes optional) and the manager (MCC) account used to log in.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# API version; bump when Google sunsets it (check the release notes).
GOOGLE_ADS_API_VERSION=v25

# ---- Google Analytics 4 + Search Console --------------------------------------
# [REC for Search Console / optional GA4] One service account JSON, added as Viewer in GA4 and as a
# restricted user in Search Console.
GOOGLE_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=
# e.g. sc-domain:amanibiometrics.com (domain property) or https://amanibiometrics.com/
SEARCH_CONSOLE_SITE_URL=sc-domain:amanibiometrics.com

# ---- Email provider: Resend (default) -------------------------------------------
# Used to (a) email the daily report to the owner, (b) LATER, approved marketing sends.
# Use a SENDING-ONLY key restricted to the amanibiometrics.com domain for report delivery.
RESEND_API_KEY=
# Optional full-access key just for reading broadcast stats (leave empty to skip that section).
RESEND_READ_API_KEY=
# Resend replaced "Audiences" with Contacts + Segments. Put the segment used for marketing here;
# RESEND_AUDIENCE_ID is kept for accounts still on the legacy Audience model.
RESEND_SEGMENT_ID=
RESEND_AUDIENCE_ID=
# Alternatives if you leave Resend: Postmark, Amazon SES, SendGrid, Loops, Customer.io (not wired).

# ---- Report delivery ----------------------------------------------------------
# Comma list: file (always written to jarvis/reports/), slack, email
REPORT_DELIVERY=file
# Slack incoming webhook for a private channel only the owner can see.
SLACK_WEBHOOK_URL=
# Email delivery via Resend (owner only).
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM="Jarvis <jarvis@amanibiometrics.com>"
