# A missing build file gets a real 404, not the app shell with a 200. Without
# "!" a rule never shadows a file that exists, so every built asset still
# serves as itself. No source map is built any more (vite.config.ts), so
# /assets/*.map now 404s. Netlify cannot match "*.map" mid-path, and a forced
# "/assets/*" would 404 every asset, which is why maps are kept out at build.
/assets/*  /index.html  404

# SPA fallback. Without this, Netlify looks for a file at the requested path
# and 404s on every client-side route — so /login, /signup, /reset-password,
# /success and everything under /app broke on direct navigation, refresh, or
# any inbound link. That includes the two flows that must survive leaving the
# app: Supabase password-recovery emails and Stripe checkout returns.
#
# Real files win over this rule, so /.well-known/apple-app-site-association
# and /.well-known/assetlinks.json still serve as themselves — which the
# universal-link and app-link verification both depend on.
/*    /index.html   200
