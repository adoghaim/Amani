{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Amani clinical catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analytes",
    "identity_only"
  ],
  "properties": {
    "schema_version": {
      "const": "1",
      "type": "string"
    },
    "analytes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "display_name",
          "short_name",
          "category",
          "subcategory",
          "canonical_unit",
          "unit_conversions",
          "specimen",
          "aliases",
          "importance",
          "score_weight",
          "sex_applicability",
          "is_cycle_dependent",
          "is_fasting_sensitive",
          "is_core",
          "is_ratio",
          "affects_scoring",
          "affects_recommendations",
          "registry_identity",
          "extraction_synonyms",
          "ranges",
          "sex_applicability_provenance",
          "catalog_metadata",
          "unit_mapping",
          "specimen_basis"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "display_name": {
            "type": "string"
          },
          "short_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": "string"
          },
          "subcategory": {
            "type": [
              "string",
              "null"
            ]
          },
          "canonical_unit": {
            "type": "string"
          },
          "unit_conversions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "factor"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "factor": {
                  "type": "number"
                }
              }
            }
          },
          "specimen": {
            "type": "string",
            "enum": [
              "serum",
              "serum_or_plasma",
              "whole_blood",
              "UNKNOWN"
            ],
            "description": "Offline hypothesis only; specimen_basis beside this value states its derivation and uncertainty. serum_or_plasma does not assert interchangeability."
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "importance": {
            "type": "string",
            "enum": [
              "critical",
              "important",
              "supporting"
            ]
          },
          "score_weight": {
            "type": "number"
          },
          "sex_applicability": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "female",
              "male",
              "all"
            ]
          },
          "is_cycle_dependent": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "is_fasting_sensitive": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "is_core": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "is_ratio": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "affects_scoring": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "affects_recommendations": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "registry_identity": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "slug",
              "display_name",
              "category",
              "subcategory",
              "unit",
              "is_core",
              "is_ratio",
              "affects_scoring",
              "affects_recommendations"
            ],
            "properties": {
              "slug": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "subcategory": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "unit": {
                "type": "string"
              },
              "is_core": {
                "type": "boolean"
              },
              "is_ratio": {
                "type": "boolean"
              },
              "affects_scoring": {
                "type": "boolean"
              },
              "affects_recommendations": {
                "type": "boolean"
              }
            }
          },
          "extraction_synonyms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "synonym_text",
                "source_type"
              ],
              "properties": {
                "synonym_text": {
                  "type": "string",
                  "minLength": 1
                },
                "source_type": {
                  "enum": [
                    "quest",
                    "labcorp",
                    "generic"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "population",
                "phase",
                "min",
                "max",
                "source",
                "source_url",
                "source_date",
                "evidence_grade",
                "review_status",
                "reviewer",
                "reviewed_at",
                "version",
                "notes",
                "value_origin",
                "value_origin_table",
                "modifiers",
                "audit"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "lab_reference",
                    "amani_context"
                  ]
                },
                "population": {
                  "type": "string",
                  "minLength": 1,
                  "enum": [
                    "general",
                    "female_adult",
                    "male_adult",
                    "pregnancy_t1",
                    "pregnancy_t2",
                    "pregnancy_t3",
                    "postpartum",
                    "postmenopausal"
                  ]
                },
                "phase": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    null,
                    "menstrual",
                    "follicular",
                    "ovulatory",
                    "luteal",
                    "general"
                  ]
                },
                "min": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "max": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "evidence_grade": {
                  "type": "string",
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "expert_opinion",
                    "unsourced"
                  ]
                },
                "review_status": {
                  "type": "string",
                  "enum": [
                    "SAFE",
                    "NEEDS_CONTEXT",
                    "DISPUTED",
                    "UNKNOWN"
                  ]
                },
                "reviewer": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reviewed_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "notes": {
                  "type": "string"
                },
                "candidate_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "value_origin": {
                  "type": "string",
                  "enum": [
                    "shipping_dictionary_2fd9433",
                    "legacy_db_table",
                    "reviewed_evidence"
                  ],
                  "description": "Shipping history is not clinical correctness: value_origin describes transcription origin and has zero clinical weight. evidence_grade/review_status answer clinical validity independently. reviewed_evidence is reserved and rejected by the implementer validator."
                },
                "value_origin_table": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Required nonblank retired table name only for legacy_db_table; otherwise null."
                },
                "modifiers": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sex",
                    "age",
                    "cycle",
                    "pregnancy",
                    "life_stage"
                  ],
                  "properties": {
                    "sex": {
                      "type": "string",
                      "enum": [
                        "requires_context",
                        "UNKNOWN"
                      ]
                    },
                    "age": {
                      "type": "string",
                      "enum": [
                        "requires_context",
                        "UNKNOWN"
                      ]
                    },
                    "cycle": {
                      "type": "string",
                      "enum": [
                        "requires_context",
                        "UNKNOWN"
                      ]
                    },
                    "pregnancy": {
                      "type": "string",
                      "enum": [
                        "requires_context",
                        "UNKNOWN"
                      ]
                    },
                    "life_stage": {
                      "type": "string",
                      "enum": [
                        "requires_context",
                        "UNKNOWN"
                      ]
                    }
                  },
                  "description": "Triage flags only, not stratified ranges or evidence of irrelevance. UNKNOWN requires a reviewer question; requires_context does not establish clinical values."
                },
                "audit": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "tier",
                    "reason",
                    "specimen_basis",
                    "population_context",
                    "kind_verification",
                    "modifiers_basis",
                    "open_question",
                    "required_artifact"
                  ],
                  "properties": {
                    "tier": {
                      "type": "string",
                      "enum": [
                        "P0",
                        "P1",
                        "P2",
                        "P3"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "specimen_basis": {
                      "type": "string",
                      "minLength": 1
                    },
                    "population_context": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind_verification": {
                      "type": "string",
                      "minLength": 1
                    },
                    "modifiers_basis": {
                      "type": "string",
                      "minLength": 1
                    },
                    "open_question": {
                      "type": "string",
                      "minLength": 1
                    },
                    "required_artifact": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "description": "Offline audit instrument. Tiers and matrix/population/modifier hypotheses are not clinical approval; artifacts are requests, not claimed sources."
                }
              }
            }
          },
          "higher_is_better": {
            "type": "boolean"
          },
          "legacy_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "sex_applicability_provenance": {
            "type": "string",
            "minLength": 1
          },
          "catalog_metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "category",
              "is_cycle_dependent",
              "is_fasting_sensitive",
              "name",
              "sex_applicability",
              "slug",
              "subcategory",
              "unit"
            ],
            "properties": {
              "category": {
                "type": "string"
              },
              "is_cycle_dependent": {
                "type": "boolean"
              },
              "is_fasting_sensitive": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              },
              "sex_applicability": {
                "type": "string",
                "enum": [
                  "female",
                  "male",
                  "all"
                ]
              },
              "slug": {
                "type": "string"
              },
              "subcategory": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              }
            }
          },
          "unit_mapping": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "legacy_unit",
              "registry_unit",
              "legacy_to_registry_factor",
              "status",
              "basis"
            ],
            "properties": {
              "legacy_unit": {
                "type": "string"
              },
              "registry_unit": {
                "type": "string"
              },
              "legacy_to_registry_factor": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "verified",
                  "refused"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "specimen_basis": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(INFERRED|UNKNOWN)",
            "description": "Basis colocated with specimen: an offline hypothesis or unresolved matrix, never reviewed assay evidence."
          }
        }
      }
    },
    "identity_only": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "display_name",
          "category",
          "subcategory",
          "unit",
          "is_core",
          "is_ratio",
          "affects_scoring",
          "affects_recommendations",
          "extraction_synonyms"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "subcategory": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "is_core": {
            "type": "boolean"
          },
          "is_ratio": {
            "type": "boolean"
          },
          "affects_scoring": {
            "type": "boolean"
          },
          "affects_recommendations": {
            "type": "boolean"
          },
          "extraction_synonyms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "synonym_text",
                "source_type"
              ],
              "properties": {
                "synonym_text": {
                  "type": "string",
                  "minLength": 1
                },
                "source_type": {
                  "enum": [
                    "quest",
                    "labcorp",
                    "generic"
                  ],
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
