logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env
.env.*
!.env.example

# Android release signing secrets
android/app/*.jks
android/keystore.properties

# Native build artifacts (defense in depth — see android/.gitignore for primary)
android/build/
android/app/build/
android/.gradle/
ios/build/
ios/Pods/
**/*.aab
**/*.apk
**/*.ipa
**/*.keystore
**/*.jks

# Supabase CLI local state (what `supabase init` writes to supabase/.gitignore)
supabase/.temp/
supabase/.branches/

# Per-machine tool output and stale dumps
graphify-out/
**/.expo/
logs.txt

# Host CLI local state (Netlify is the web host; Vercel dir is a leftover)
.netlify/
.vercel/

# Local agent-tooling runtime state (per-machine, not shareable)
.claude-flow/
**/.claude-flow/
.swarm/
*.rvf
*.rvf.lock
ruvector.db
**/ruvector.db
.claude/proven-config.json
.claude/.proven-config-version

# impeccable — installs ~10 MB as three duplicate copies and registers its
# hooks in gitignored .claude/settings.local.json, so a clone needs
# `npx impeccable install` to activate it regardless. Keep it out of the repo.
.agents/skills/impeccable/
.claude/skills/impeccable/

# Agent worktrees. Created under .claude/ by background agents; each is a full
# second checkout of this repo, so an unguarded `git add -A` would commit a
# duplicate tree. Never versioned.
.claude/worktrees/
.github/skills/
.github/hooks/
.github/agents/
.codex/
deno.lock

# Output of tools/preview (visual check screenshots)
preview-shots/

# Build artifacts for manual install/distribution. Large binaries, never versioned.
artifacts/

# Playwright diagnostics and local synthetic session state
/playwright-report/
/test-results/
/blob-report/
/e2e/.auth/
/e2e/.dist-preview/

# graphify: the shared knowledge graph (graph.json, graph.html, GRAPH_REPORT.md,
# manifest.json, .graphify_labels.json) is versioned; the extraction cache, the
# token-cost log and the per-machine interpreter/root/scratch files are not.
/graphify-out/cache/
/graphify-out/cost.json
/graphify-out/.graphify_*
!/graphify-out/.graphify_labels.json
/graphify-out/.needs_update
