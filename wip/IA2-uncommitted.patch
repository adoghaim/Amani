+    report_analytes: [
+      analyte('a1', 'r1', 'tsh', 2.2, {}),
+      analyte('a2', 'r2', 'tsh', 0.0008, { needs_review: false, reviewed_by_user: true, confidence_score: 'high' }),
+    ],
+  });
+  await openLabs();
+  expect(ids(fixture.compareViewProps[fixture.compareViewProps.length - 1])).toEqual({ r1: ['b1'], r2: ['b2'] });
+});
