index fbeac76..a2b5430 100644
--- a/supabase/functions/_shared/schemas/context.ts
+++ b/supabase/functions/_shared/schemas/context.ts
@@ -39,6 +39,13 @@ export const LabReportContextSchema = z
 
 export type LabReportContext = z.infer<typeof LabReportContextSchema>;
 
+// A trimmed string of at most `max` UTF-16 units (String#length), the unit
+// the caps below were set in and zod 3 counted. zod 4's string .max() counts
+// code points instead, which would let astral characters such as emoji carry
+// up to twice as many units into the prompt.
+const boundedText = (max: number) =>
+  z.string().trim().refine((s) => s.length <= max, `Too big: expected string to have <=${max} UTF-16 units`);
+
 // Voluntary profile fields the user enters in onboarding / Settings.
 // These are user-writable via RLS UPDATE on `users`, so every field that
 // flows into the OpenAI prompt is a prompt-injection surface. All fields
@@ -48,12 +55,12 @@ export type LabReportContext = z.infer<typeof LabReportContextSchema>;
 // those carry the highest risk of model-prescriptive drift and are not
 // part of this slice.
 export const UserProfileContextSchema = z.object({
-  full_name: z.string().trim().max(80).nullable().optional(),
-  age_range: z.string().trim().max(40).nullable().optional(),
-  sex_at_birth: z.string().trim().max(40).nullable().optional(),
-  pregnancy_status: z.string().trim().max(40).nullable().optional(),
-  health_goals: z.array(z.string().trim().max(80)).max(10).nullable().optional(),
-  symptoms: z.array(z.string().trim().max(120)).max(10).nullable().optional(),
+  full_name: boundedText(80).nullable().optional(),
+  age_range: boundedText(40).nullable().optional(),
+  sex_at_birth: boundedText(40).nullable().optional(),
+  pregnancy_status: boundedText(40).nullable().optional(),
+  health_goals: z.array(boundedText(80)).max(10).nullable().optional(),
+  symptoms: z.array(boundedText(120)).max(10).nullable().optional(),
 });
 
 export type UserProfileContext = z.infer<typeof UserProfileContextSchema>;
