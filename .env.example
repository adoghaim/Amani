# Supabase project (client-exposed via Vite).
# REQUIRED — src/lib/supabase.ts throws at import if either is missing. There is
# deliberately no fallback: a preview build with an unset var used to compile
# against the production project and write real users' rows.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe publishable key (optional in dev)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Apple OAuth (optional; set to 'true' to show Apple sign-in button)
VITE_ENABLE_APPLE_OAUTH=

# Public origin used for links that leave the app (password-reset emails,
# Stripe redirects). Must match the domain in the deep-link entitlement/manifest.
# Defaults to https://amanibiometrics.com on native, window.location.origin on web.
VITE_APP_URL=

# Sentry DSN for error monitoring (optional).
# Unset is a supported state: main.tsx skips Sentry.init entirely, so dev and
# deploy previews stay quiet instead of reporting noise into the production
# project. Set it only on the production Netlify site. VITE_* values are baked
# into the bundle at build time, so changing this requires a REBUILD, not just
# a redeploy.
VITE_SENTRY_DSN=

# RevenueCat public SDK keys, per store (native builds only).
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=

# Sandbox in-app purchases.
#
# There is no variable here any more. `VITE_ALLOW_SANDBOX_IAP` (and its server
# twin `ALLOW_SANDBOX_IAP`) were removed: they were a single boolean that, when
# true, let EVERY StoreKit/Play sandbox receipt entitle EVERY user holding one,
# and sandbox receipts cost nothing to mint. They also had to be kept in step
# with each other by hand, and when they drifted a TestFlight tester saw
# "Active Subscription" on /app/billing and was then bounced out of every paid
# screen.
#
# Sandbox entitlement is now a per-tester row in `iap_beta_testers`, written
# server-side with the service role and readable by that tester alone:
#
#   insert into iap_beta_testers (user_id, platform, expires_at)
#   values ('<auth.users.id>', 'both', now() + interval '90 days');
#
# Nothing needs to be set in this file, or rebuilt, to add or revoke a tester.
# See IAP_SETUP.md §9.1 and migration 20260903120000_add_iap_beta_testers.sql.
