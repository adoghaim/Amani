<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        windowLightNavigationBar landed in API 27 and minSdk here is 24, so it
        lives in a v27 qualifier rather than the base theme. Same meaning as the
        status-bar attribute: the bar sits on a light background, so draw dark
        icons on it. Without this the gesture pill and the three-button icons
        are white on Amani's ivory bottom surface.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/amaniBackground</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@color/amaniBackground</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/amaniBackground</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@color/amaniBackground</item>
    </style>
</resources>
