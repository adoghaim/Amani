{
  "name": "amani",
  "private": true,
  "version": "1.0.6",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "test:e2e:journey": "playwright test -c e2e/journey/playwright.config.ts",
    "test:e2e:journey:guard": "node --test e2e/journey/real-stack-guard.test.mjs",
    "clinical:generate": "node tools/clinical/generate.mjs && node tools/clinical/audit-queue.mjs && node tools/clinical/language-policy.mjs",
    "clinical:check": "node tools/clinical/generate.mjs --check && node tools/clinical/audit-queue.mjs --check && node tools/clinical/language-policy.mjs --check",
    "clinical:test": "node --test --test-concurrency=1 tools/clinical/catalog.test.mjs tools/clinical/convergence.test.mjs tools/clinical/sql-parse-guard.test.mjs tools/clinical/value-identity.test.mjs tools/clinical/audit.test.mjs tools/clinical/audit-amendment.test.mjs tools/clinical/review-status.test.mjs tools/clinical/language-policy.test.mjs",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . && npm run clinical:lint",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && npm run clinical:typecheck && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p tools/mcp-amani/tsconfig.json",
    "check:functions": "bash docs/check-functions.sh npx --yes deno@2.1.4",
    "check:pinned-imports": "node tools/supply-chain/check-pinned-imports.mjs",
    "test:supply-chain": "node --test tools/supply-chain/pinned-imports.test.mjs",
    "test:device-lock": "node --test tools/device-lock/native-boundary.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "BUILD_TARGET=native vite build && npx cap sync",
    "preview:shots": "node tools/preview/shoot.mjs",
    "prepare": "husky",
    "validate:contrast": "node tools/contrast/validate.mjs",
    "clinical:test:ci": "node --test --test-concurrency=1 tools/clinical/catalog.test.mjs tools/clinical/convergence.test.mjs tools/clinical/sql-parse-guard.test.mjs tools/clinical/audit.test.mjs tools/clinical/audit-amendment.test.mjs tools/clinical/review-status.test.mjs tools/clinical/language-policy.test.mjs",
    "clinical:lint": "eslint --config tools/clinical/eslint.config.mjs tools/clinical",
    "clinical:typecheck": "tsc -p tools/clinical/tsconfig.json",
    "clinical:audit": "node tools/clinical/audit-queue.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:isolation": "node --test e2e/env-isolation.test.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/camera": "8.2.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/network": "^8.0.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@revenuecat/purchases-capacitor": "13.7.3",
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^0.344.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "1.64.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "acorn": "^8.12.1",
    "autoprefixer": "^10.6.1",
    "axe-core": "4.13.0",
    "esbuild": "0.21.5",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "js-yaml": "4.3.2",
    "jsdom": "26.1.0",
    "lint-staged": "^16.4.0",
    "playwright": "1.64.0",
    "postcss": "^8.5.30",
    "supabase": "2.120.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.2",
    "vitest": "^2.1.9",
    "zod": "^3.25.76"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'npm run typecheck'"
    ]
  }
}
